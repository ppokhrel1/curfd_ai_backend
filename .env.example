# General
PROJECT_NAME=Curfd AI Backend
API_V1_STR=/api/v1
SECRET_KEY=your-secret-key-change-in-production-min-32-chars

# Database
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=curfd_ai
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost/curfd_ai

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# ML Service
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT=300

# CORS - Add your frontend URLs
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
